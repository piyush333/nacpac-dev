# Jico Agentic System Configuration Template
# Copy to .env and fill in actual values (never commit .env with secrets)

# ============ ANTHROPIC ============
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ============ SUPABASE ============
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_key_here

# ============ DISCORD ============
DISCORD_TOKEN=your_discord_bot_token_here
DISCORD_GUILD_ID=your_guild_id_here
DISCORD_GENERAL_CHANNEL_ID=your_general_channel_id_here
DISCORD_BUILDS_CHANNEL_ID=your_builds_channel_id_here
DISCORD_DEPLOYS_CHANNEL_ID=your_deploys_channel_id_here
ALLOWED_USER_ID=your_discord_user_id_here

# ============ REPOS ============
NACPAC_REPO_PATH=/home/ubuntu/nacpac-workspace-main
JICO_REPO_PATH=/home/ubuntu/nacpac-workspace-main

# ============ BUILD ============
EAS_BUILD_PROFILE=preview
FIREBASE_PROJECT=nacpac-production-4134a

# ============ CLOUDFLARE R2 ============
R2_ACCOUNT_ID=your_r2_account_id_here
R2_ACCESS_KEY_ID=your_r2_access_key_here
R2_SECRET_ACCESS_KEY=your_r2_secret_key_here
R2_BUCKET_NACPAC=nacpac-builds
R2_BUCKET_JICO=jico-builds

# ============ GOOGLE DRIVE ============
GOOGLE_DRIVE_CREDENTIALS_JSON=/path/to/google-service-account.json
GOOGLE_DRIVE_FOLDER_ID=your_google_drive_folder_id_here

# ============ GITHUB ============
GITHUB_TOKEN=your_github_token_here
GITHUB_REPO=piyush333/nacpac-dev

# ============ COST CAPS ============
DAILY_CAP_USD=10.0
MONTHLY_CAP_USD=50.0

# ============ SYSTEM ============
SYSTEM_USER=ubuntu
ORACLE_VM_IP=68.233.110.235
SSH_KEY_PATH=/home/ubuntu/.ssh/oracle_key.key
