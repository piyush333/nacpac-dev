rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Jobs: authenticated users can read/create; operators can update ──
    match /jobs/{jobId} {
      // Any authenticated user can read jobs
      allow read: if request.auth != null;

      // Only authenticated users can create jobs (admin from phone)
      allow create: if request.auth != null
        && request.resource.data.keys().hasAll(['title', 'status', 'priority', 'createdBy'])
        && request.resource.data.status == 'pending'
        && request.resource.data.createdBy == request.auth.uid;

      // Any authenticated user can update (status changes from desktop, etc.)
      allow update: if request.auth != null;

      // Only admins can delete (UID must exist in /admins collection)
      allow delete: if request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // ── Admins: read-only from client; managed via Firebase Console / Admin SDK ──
    match /admins/{uid} {
      allow read:  if request.auth != null;
      allow write: if false;
    }

    // ── Notifications: authenticated users can read/create ───────────────
    match /notifications/{notifId} {
      allow read:   if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;  // mark as read
      allow delete: if request.auth != null;
    }

    // ── Clients: authenticated users can read/write ───────────────────
    match /clients/{clientId} {
      allow read:   if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if request.auth != null;
    }
  }
}
