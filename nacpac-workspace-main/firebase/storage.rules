rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ── Job attachments ───────────────────────────────────────────────────
    match /jobs/{jobId}/{allPaths=**} {
      // Any authenticated user can read/write job files
      allow read:  if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size < 50 * 1024 * 1024;  // 50 MB limit per file
    }
  }
}
